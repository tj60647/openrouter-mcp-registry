# apps/web runtime env (frontend/demo + minimal server-side proxy)
# NEXT_PUBLIC_* values are browser-visible. Never put secrets in NEXT_PUBLIC vars.

# Public URL of this web app.
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app

# Public URL of the separate MCP app. Browser-visible URL only, not a secret.
# Doubles as the redirect target in next.config.ts: when set, this app
# 308-redirects /api/mcp, /api/mcp/*, /api/oauth/* and /.well-known/* to the MCP
# host (308 preserves POST bodies). Leave unset for single-host local dev.
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app

# Optional server-side override for the MCP app URL, useful in local dev.
MCP_URL=http://localhost:3001

# Server-side OAuth client credentials used by apps/web route handlers to call apps/mcp.
# Required in Vercel preview/production when apps/mcp has OAUTH_JWT_SECRET configured.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional: only required if apps/web owns admin session cookies.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=your-session-signing-secret

# Optional: GitHub sign-in for /admin. All three are required together —
# sign-in stays hidden and the routes 404 unless every one is set, and an
# empty GITHUB_ADMIN_LOGINS never means "anyone".
# Create an OAuth app at https://github.com/settings/developers with
# Authorization callback URL: <this app's origin>/api/admin/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to administer. Case-insensitive.
GITHUB_ADMIN_LOGINS=

# Optional chat model id passed through to apps/mcp /api/chat.
CHAT_MODEL=google/gemini-3.5-flash

# Local/CI script-only, not an apps/web Vercel runtime requirement:
# POSTGRES_URL=postgres://...
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-password
