# apps/web — frontend/demo runtime env
# NEXT_PUBLIC_* values are browser-visible. Never put secrets in NEXT_PUBLIC vars.

# Public URL of this web app. Safe to expose.
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app

# Public URL of the separate MCP/backend app. Safe to expose.
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app

# Server-side MCP URL override. Useful locally when apps/mcp runs on port 3001.
# Keep this server-side; do not prefix with NEXT_PUBLIC unless it is a public URL.
MCP_URL=http://localhost:3001

# Server-side OAuth client credentials used by apps/web route handlers to call apps/mcp.
# Required in Vercel preview/production when apps/mcp has OAUTH_JWT_SECRET configured.
# Must match MCP_CLIENT_ID/MCP_CLIENT_SECRET configured on apps/mcp.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Optional: only needed if apps/web owns admin session cookies for /admin pages.
# This signs the web session cookie; admin credential validation happens in apps/mcp.
ADMIN_SESSION_SECRET=
