# OpenRouter API key (required)
OPENROUTER_API_KEY=sk-or-...

# Vercel Postgres connection string (required)
POSTGRES_URL=postgres://...

# Admin secret for protected endpoints (required)
ADMIN_SECRET=your-secure-admin-secret

# ── OAuth / MCP Authentication ────────────────────────────────────────────────
# REQUIRED in production. Signs JWT access tokens for the MCP endpoint.
# Leave empty only for local dev (anonymous access is allowed in dev mode).
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=

# Static service client credentials — use these to issue a token for the
# apps/web chatbot (or any other trusted internal client) without dynamic
# registration. If unset, only dynamically registered clients can authenticate.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Set to true to allow unauthenticated clients to self-register at
# /api/oauth/register. Leave unset (default: disabled) in production.
OAUTH_ENABLE_REGISTRATION=

# Cron secret - Vercel injects this automatically when a Neon database is attached.
# REQUIRED in production — the cron route returns 503 when not set.
CRON_SECRET=
