# apps/mcp runtime env (canonical backend/MCP service)

# OpenRouter API key. apps/mcp is the only runtime owner of this secret.
OPENROUTER_API_KEY=sk-or-...

# Neon/Postgres connection string. apps/mcp is the canonical runtime DB owner.
POSTGRES_URL=postgres://...

# Admin secret for protected backend admin endpoints. Server-side only.
ADMIN_SECRET=your-secure-admin-secret

# REQUIRED in production. Signs JWT access tokens for /api/mcp and protected
# MCP-owned HTTP helper routes. Leave empty only for local dev/test.
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=

# Static service client credentials. Set the same values in apps/web so its
# server route handlers can obtain short-lived MCP bearer tokens. Server-side only.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Public canonical URL of this MCP deployment. Browser-visible URL only; not a secret.
# Optional on Vercel because VERCEL_URL is used as a fallback, but set it for custom domains.
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app

# Public URL of the docs/web host (apps/web). Same value as apps/web's
# NEXT_PUBLIC_APP_URL. When set, next.config.ts 308-redirects /mcp-info to
# ${NEXT_PUBLIC_WEB_URL}/mcp-info; when unset, /mcp-info 404s here because this
# app serves the API only. Browser-visible URL only; not a secret.
NEXT_PUBLIC_WEB_URL=https://your-web-app.vercel.app

# OAuth 2.1 Dynamic Client Registration is ENABLED by default so interactive MCP
# clients (Claude Code, Cursor, VS Code) can complete the authorization-code +
# PKCE flow. Set to true only if you provision clients manually and want to
# refuse self-registration.
OAUTH_DISABLE_REGISTRATION=

# Optional initial access token for POST /api/oauth/register (RFC 7591 §3.1).
# When set, registration requires `Authorization: Bearer <this value>` and
# returns 401 invalid_token otherwise. Leave empty to keep registration open
# (the default) so interactive MCP clients can still bootstrap themselves.
# Generate with: openssl rand -hex 32
OAUTH_REGISTRATION_ACCESS_TOKEN=

# Cron secret. Vercel injects this automatically for configured cron jobs.
# REQUIRED in production — the cron route returns 503 when not set.
CRON_SECRET=
