# OpenRouter API key (required)
OPENROUTER_API_KEY=sk-or-...

# Vercel Postgres connection string (required)
POSTGRES_URL=postgres://...

# Admin secret for protected endpoints (required)
ADMIN_SECRET=your-secure-admin-secret

# MCP API key - REQUIRED in production. The /api/mcp endpoint returns 503 when
# this is not set and NODE_ENV=production. Generate with: openssl rand -hex 32
MCP_API_KEY=

# Cron secret - Vercel injects this automatically when a Neon database is attached.
# REQUIRED in production — the cron route returns 503 when not set.
CRON_SECRET=
