# apps/mcp — canonical backend/MCP runtime env

# OpenRouter API key. Required by apps/mcp for chat, model sync, and embeddings.
OPENROUTER_API_KEY=sk-or-...

# Neon/Postgres pooled runtime connection string. Required by apps/mcp.
POSTGRES_URL=postgres://...

# Admin secret for direct protected backend/admin endpoints.
ADMIN_SECRET=your-secure-admin-secret

# REQUIRED in production. Signs JWT access tokens for the MCP and backend proxy endpoints.
# Leave empty only for local dev (anonymous MCP access is allowed in dev mode).
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=

# Static service client credentials. Set the same values in apps/web so the demo can
# obtain short-lived tokens with the client-credentials grant. Keep both server-side.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Public canonical URL of this MCP deployment. Optional on Vercel because VERCEL_URL
# is used as a fallback, but set it when using a custom domain. Safe to expose.
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app

# Set to true to allow unauthenticated clients to self-register at /api/oauth/register.
# Leave unset (default: disabled) in production unless you intentionally allow it.
OAUTH_ENABLE_REGISTRATION=

# Vercel cron auth. Required in production if cron routes are deployed.
CRON_SECRET=

# Optional OpenRouter model used by the backend chat endpoint.
CHAT_MODEL=google/gemini-3.5-flash
