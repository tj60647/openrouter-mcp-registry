{
  "name": "openrouter-registry-mcp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @openrouter-mcp/web --filter @openrouter-mcp/mcp dev",
    "build": "pnpm --filter @openrouter-mcp/web build && pnpm --filter @openrouter-mcp/mcp build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @openrouter-mcp/web db:migrate",
    "db:seed": "pnpm --filter @openrouter-mcp/web db:seed",
    "db:create-admin": "pnpm --filter @openrouter-mcp/web db:create-admin",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "test:coverage": "pnpm -r test:coverage",
    "ci": "pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm run build"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@11.17.0"
}
