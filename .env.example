# OpenRouter MCP Registry — combined local example
# Prefer app-specific files: apps/mcp/.env.example and apps/web/.env.example.
# NEXT_PUBLIC_* values are browser-visible. Never put secrets in NEXT_PUBLIC vars.

# apps/mcp runtime only
OPENROUTER_API_KEY=sk-or-v1-...
POSTGRES_URL=postgres://...
ADMIN_SECRET=change-me-to-a-long-random-string
OAUTH_JWT_SECRET=change-me-to-a-jwt-secret
CRON_SECRET=
CHAT_MODEL=google/gemini-3.5-flash

# Shared server-side web→mcp OAuth client credentials
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
OAUTH_ENABLE_REGISTRATION=

# apps/web runtime
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app
MCP_URL=http://localhost:3001

# Local/CI script-only bootstrap variables
# POSTGRES_URL is also used by apps/web scripts for migrations, seed, and admin bootstrap.
# Runtime apps/web deployments should not need POSTGRES_URL.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-password
