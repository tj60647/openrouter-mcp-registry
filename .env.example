# ─────────────────────────────────────────────
# OpenRouter Registry MCP — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local (for local dev) or configure in Vercel dashboard

# ── Required ──────────────────────────────────

# OpenRouter API key used to fetch the model catalog
OPENROUTER_API_KEY=sk-or-v1-...

# Vercel Postgres connection string
# Get from: Vercel Dashboard → Storage → Postgres → .env.local tab
POSTGRES_URL=******host:5432/verceldb

# Secret token required for protected admin endpoints:
#   POST /api/admin/refresh
#   GET  /api/admin/sync-status
# Also used by apps/web when proxying refresh requests to apps/mcp.
# Use a long random string: openssl rand -hex 32
ADMIN_SECRET=change-me-to-a-long-random-string

# Secret used to sign admin session cookies in apps/web.
# Must be a separate random 32-byte hex string.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-another-long-random-string

# Bootstrap the first web admin with:
#   ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-password pnpm db:create-admin -- --username admin
# Runtime admin credentials are stored in Postgres, not environment variables.

# ── OAuth / MCP Authentication ─────────────────────────────────────────────────
# REQUIRED in production for apps/mcp. Signs JWT access tokens used to
# authenticate MCP clients. Without this, the /api/mcp endpoint returns 401 in
# production (open only in dev/test for convenience).
# Generate with: openssl rand -hex 32
OAUTH_JWT_SECRET=change-me-to-a-jwt-secret

# Static client credentials for the apps/web chatbot to authenticate with
# apps/mcp without dynamic registration. Required for Vercel preview/production
# when OAUTH_JWT_SECRET is configured. Keep both server-side.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Set to true to allow clients to self-register at /api/oauth/register.
# Disabled by default. Do not enable in production unless you intend to
# allow open client registration.
OAUTH_ENABLE_REGISTRATION=

# ── Optional ──────────────────────────────────

# Vercel automatically injects CRON_SECRET for cron jobs.
# You only need this if running cron locally.
CRON_SECRET=

# Public URL of the deployed web app (used in the MCP Info page and OpenRouter referer)
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app

# Public canonical URL of the deployed MCP app. Safe to expose; do not put tokens here.
NEXT_PUBLIC_MCP_URL=https://your-mcp-app.vercel.app

# Server-side override for the MCP app URL, useful for local web→mcp calls.
MCP_URL=http://localhost:3001

# Optional OpenRouter model used by apps/web /demo chatbot.
CHAT_MODEL=google/gemini-3.5-flash
